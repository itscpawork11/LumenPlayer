<Window x:Class="LumenPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Lumen Player"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H2Style}" Text="Lumen Player"/>
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="  •  Media workspace" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" Text="Window commands (system)" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar (reserved) -->
            <Border Grid.Column="0" Margin="0,0,12,0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                <StackPanel Margin="16">
                    <TextBlock Style="{StaticResource H2Style}" Text="Library"/>
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Media &amp; playlist panel (reserved)" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Main viewing area -->
            <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <vlc:VideoView x:Name="VideoSurface" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource H1Style}" Text="Media Viewport" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Reserved for future media rendering. No playback in this phase." HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,0" Padding="12">
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Status: Ready (static prototype)"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom control region (reserved) -->
        <Border Grid.Row="2" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="12,0,12,12" CornerRadius="12">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource CaptionStyle}" Text="Playback controls (reserved) — non-functional placeholders" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="32" Margin="4" Background="{DynamicResource Surface2Brush}" CornerRadius="8"/>
                    <Border Width="40" Height="32" Margin="4" Background="{DynamicResource Surface2Brush}" CornerRadius="8"/>
                    <Border Width="40" Height="32" Margin="4" Background="{DynamicResource Surface2Brush}" CornerRadius="8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
